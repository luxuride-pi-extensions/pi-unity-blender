{
  "name": "@luxuride-pi/unity-blender",
  "version": "0.1.2",
  "description": "pi extension: /unity-blender binder that moves meshes and materials between a live Blender session and a live Unity project",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "config.ts",
    "manager-core.ts",
    "core/",
    "binder/",
    "agents/",
    "skills/",
    "scripts/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/parse-summary.mjs && node test/manager-prompt.mjs && node --test \"test/*.test.mjs\"",
    "test:scripts": "node --test \"test/binder-scripts.test.mjs\"",
    "test:unit": "node test/parse-summary.mjs && node test/manager-prompt.mjs && node --test \"test/registration.test.mjs\"",
    "install:agents": "node scripts/install-agents.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@luxuride-pi/manager-core": "*"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxuride-pi-extensions/pi-unity-blender.git"
  }
}
